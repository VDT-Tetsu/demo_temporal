# Copy file nay thanh .env roi dien gia tri. Ca docker-compose va Spring Boot deu doc file .env nay.

# ---------- Spring Boot app ----------
SERVER_PORT=8081
# Duong dan file H2 (khong co duoi .mv.db). Xoa thu muc data/ de reset du lieu tenant
H2_DB_PATH=./data/onboarding

# ---------- Ket noi Temporal ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tenant-onboarding
# Link Temporal UI hien tren FE (docker-compose: http://localhost:8080, CLI dev server: http://localhost:8233)
TEMPORAL_UI_URL=http://localhost:8080

# ---------- Hanh vi demo onboarding ----------
# Ti le loi ngau nhien moi lan chay 1 buoc (0.0 = khong bao gio loi, 1.0 = luon loi)
ONBOARDING_FAILURE_RATE=0.3
# Thoi gian gia lap moi buoc: moi lan chay random trong [MIN, MAX] (dinh dang Spring Duration: 500ms, 15s, 1m...)
ONBOARDING_STEP_DELAY_MIN=15s
ONBOARDING_STEP_DELAY_MAX=30s
# So lan Temporal tu retry 1 buoc truoc khi chuyen sang WAITING_RETRY
ONBOARDING_ACTIVITY_MAX_ATTEMPTS=3
# Thoi gian cho admin approve/reject
ONBOARDING_APPROVAL_TIMEOUT=10m
# Thoi gian cho trigger retry/abort khi 1 buoc loi
ONBOARDING_MANUAL_RETRY_TIMEOUT=30m

# ---------- docker-compose (phuong an 1) ----------
TEMPORAL_SERVER_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.57.0
POSTGRES_VERSION=16
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
# Thoi gian Temporal giu workflow da ket thuc (chi ap dung khi tao namespace lan dau)
TEMPORAL_RETENTION=168h

# ---------- Temporal CLI dev server (phuong an 2) ----------
TEMPORAL_CLI_UI_PORT=8233
